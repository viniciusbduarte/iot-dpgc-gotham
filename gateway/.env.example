# Configurações do Broker MQTT Local (Mosquitto)
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883
TOPIC_BATSIGNAL=gotham/dpgc/vinicius/batsignal
TOPIC_STATUS=gotham/dpgc/vinicius/status

# Configurações do InfluxDB Local
INFLUX_HOST=127.0.0.1
INFLUX_PORT=8086
INFLUX_DB=gotham_dpgc

# Configurações da Nuvem (Adafruit IO)
AIO_HOST=io.adafruit.com
AIO_PORT=443
AIO_TRANSPORT=websockets
AIO_WS_PATH=/mqtt
AIO_USERNAME=seu_usuario_adafruit
AIO_KEY=sua_chave_aio_aqui
